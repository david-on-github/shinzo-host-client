# Copy to .env; docker compose reads it automatically. Only the passphrase is required.
SHINZO_KEY_PASSPHRASE=change-me          # encrypts the node's identity keys on disk (or SHINZO_KEY_PASSPHRASE_FILE=/run/secrets/passphrase)
#SHINZO_NETWORK=testnet                  # testnet | custom
#SHINZO_HOST_VERSION=latest              # image tag; pin to vX.Y.Z for production
#BOOTSTRAP_PEERS=https://node.example    # extra peers: node URLs, IPs or multiaddrs (comma-separated)
#ALLOWED_ORIGINS=http://localhost:3000   # extra browser origins (comma-separated)
#LOG_LEVEL=info                          # debug | info | warn | error
